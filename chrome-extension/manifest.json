{
  "manifest_version": 3,
  "name": "Leaf Me Alone — Focus Guard",
  "version": "1.7.0",
  "description": "Only while a Leaf Me Alone focus session runs: blocks new tabs/windows and pulls you back to the game window. Allows everything otherwise.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["link-tracker.js"],
      "run_at": "document_start"
    }
  ]
}
