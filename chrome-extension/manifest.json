{
  "manifest_version": 3,
  "name": "Leaf Me Alone — Strict Tab Guard",
  "version": "1.3.0",
  "description": "Blocks opening new tabs (Cmd+T / +) during focus; only allows tabs opened by clicking links on existing allowed tabs.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "blocked.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["link-tracker.js"],
      "run_at": "document_start"
    }
  ]
}
