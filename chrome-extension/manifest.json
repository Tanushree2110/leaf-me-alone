{
  "manifest_version": 3,
  "name": "Leaf Me Alone — Focus Tab Guard",
  "version": "1.5.0",
  "description": "Blocks new tabs ONLY when localhost:5173 is open and Pomodoro Focus is started. Never blocks Chrome when game is closed.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["link-tracker.js"],
      "run_at": "document_start"
    }
  ]
}
